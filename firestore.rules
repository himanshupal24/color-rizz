rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string
    //   - phone: string
    //   - role: string ("user" | "admin")
    //   - balance: number
    //   - referralCode: string
    //   - referredBy: string | null (optional)
    //   - bankDetails: map (optional)
    //   - createdAt: number
    //
    // Collection: settings
    // Document ID: game
    //
    // Collection: rounds
    // Document ID: {roundId}
    //
    // Collection: round_plans
    // Document ID: {roundId}
    //
    // Collection: bets
    // Document ID: {betId}
    //
    // Collection: transactions
    // Document ID: {txId}
    //
    // Collection: recharges
    // Document ID: {rechargeId}
    //
    // Collection: withdrawals
    // Document ID: {withdrawalId}
    //
    // Collection: notifications
    // Document ID: {notificationId}
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow user to update their own bankDetails or displayName only; never balance/role/referralCode/phone/createdAt/uid/bonusBalance/cashBalance/unlockedBonusBalance/totalWagered
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'balance', 'cashBalance', 'bonusBalance', 'unlockedBonusBalance', 'totalWagered',
          'role', 'phone', 'referralCode', 'referredBy', 'createdAt', 'referralCreatedAt', 'uid'
        ]);
      allow create, delete: if false; // Server Admin SDK only
    }

    // Referral rewards collection (read own rewards or admin; write server only)
    match /referral_rewards/{rewardId} {
      allow read: if isAuthenticated() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid || isAdmin());
      allow write: if false; // Server Admin SDK only
    }

    // Public game settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live rounds and settled round history (public read, write server only)
    match /rounds/{roundId} {
      allow read: if true;
      allow write: if false; // Server Admin SDK only
    }

    // Planned round results (ADMIN ONLY - protected from players)
    match /round_plans/{roundId} {
      allow read, write: if isAdmin();
    }

    // Round statistics aggregates (ADMIN ONLY - real-time monitoring)
    match /round_stats/{roundId} {
      allow read: if isAdmin();
      allow write: if false; // Server Admin SDK only
    }

    // Bets collection (read own bets or admin; create/update via server only)
    match /bets/{betId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false; // Server Admin SDK handles bets
    }

    // Transactions collection (read own or admin; write server only)
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false; // Server Admin SDK only
    }

    // Recharges (read own or admin; write server only)
    match /recharges/{rechargeId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false; // Server Admin SDK only
    }

    // Withdrawals (read own or admin; write server only)
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false; // Server Admin SDK only
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (!('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false; // Server Admin SDK only
    }

    // OTP collection - Server Admin SDK only
    match /phoneOtps/{phone} {
      allow read, write: if false;
    }

    // Idempotency keys - Server Admin SDK only
    match /idempotency_keys/{keyId} {
      allow read, write: if false;
    }

    // Audit logs - Admin read only, Server Admin SDK write
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reconciliation reports - Admin read only, Server Admin SDK write
    match /reconciliations/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}

